#!/usr/bin/env bash
# /usr/libexec/bluefin-countme
# Weekly anonymous countme reporting service for Dakota images
set -euo pipefail

IMAGE_INFO="${IMAGE_INFO_FILE:-/usr/share/ublue-os/image-info.json}"
STATE_DIR="${STATE_DIRECTORY:-/var/lib/bluefin-countme}"
BOOTED_IMAGE_FILE="${BOOTED_IMAGE_FILE:-/run/ublue-os/booted-image}"
NOW=$(date +%s)
WEEK=604800
# Unix epoch was Thursday; adding three days aligns week numbers to UTC Monday.
UTC_WEEK=$(( (NOW + 259200) / WEEK ))

# 1. Opt-out checks
if [[ -f /etc/projectbluefin/countme/disabled ]] || \
   [[ -f /etc/bluefin-countme-opt-out ]] || \
   [[ -f /etc/dakota-countme/disabled ]]; then
    exit 0
fi

# 2. Image scope: track only Dakota images, labeled as "Bluefin".
# Non-Dakota systems exit 0 immediately without touching state or making network calls.
if [[ ! -f "$IMAGE_INFO" ]]; then
    exit 0
fi
raw_name=$(jq -r '."image-name" // empty' "$IMAGE_INFO" 2>/dev/null || true)
if [[ -z "$raw_name" ]] || [[ "$raw_name" != dakota* ]]; then
    exit 0
fi

# Ensure state directory exists
mkdir -p "$STATE_DIR"

EPOCH_FILE="${STATE_DIR}/epoch"
LASTRUN_FILE="${STATE_DIR}/lastrun"

# 3. Initialize epoch file on first run or recover if corrupt
if [[ -f "$EPOCH_FILE" ]]; then
    EPOCH=$(< "$EPOCH_FILE")
    if ! [[ "$EPOCH" =~ ^[0-9]+$ ]]; then
        echo "$NOW" > "$EPOCH_FILE"
        EPOCH="$NOW"
    fi
else
    echo "$NOW" > "$EPOCH_FILE"
    EPOCH="$NOW"
fi

# 4. Send at most one successful report per UTC week, even with daily retries.
if [[ -f "$LASTRUN_FILE" ]]; then
    LASTRUN=$(< "$LASTRUN_FILE")
    if [[ "$LASTRUN" =~ ^[0-9]+$ ]] && (( (LASTRUN + 259200) / WEEK == UTC_WEEK )); then
        exit 0
    fi
fi

# 5. Compute Fedora-style week bucket
WEEKS=$(( (NOW - EPOCH) / WEEK + 1 ))
if (( WEEKS == 1 )); then
    BUCKET=1    # First week
elif (( WEEKS >= 2 && WEEKS <= 4 )); then
    BUCKET=2    # First month (weeks 2-4)
elif (( WEEKS >= 5 && WEEKS <= 24 )); then
    BUCKET=3    # First 6 months (weeks 5-24)
else
    BUCKET=4    # >6 months
fi

# 6. Extract image metadata
REPO="dakota"
TAG=""
FLAVOR="main"

raw_flavor=$(jq -r '."image-flavor" // empty' "$IMAGE_INFO" 2>/dev/null || true)
if [[ -n "$raw_flavor" ]]; then
    FLAVOR="$raw_flavor"
fi

raw_tag=$(jq -r '."image-tag" // empty' "$IMAGE_INFO" 2>/dev/null || true)
if [[ -n "$raw_tag" ]]; then
    TAG="$raw_tag"
fi

# 7. Extract true runtime tag (:stable vs :testing) from booted deployment
# Avoid compose-time defaults; inspect /run/ublue-os/booted-image or bootc status
booted_ref=""
if [[ -r "$BOOTED_IMAGE_FILE" ]]; then
    read -r booted_ref < "$BOOTED_IMAGE_FILE" || true
fi

if [[ -z "$booted_ref" ]] && command -v bootc &>/dev/null; then
    bootc_stderr=$(mktemp)
    if bootc_out=$(bootc status --json 2>"$bootc_stderr"); then
        booted_ref=$(printf '%s' "$bootc_out" | jq -r '.status.booted.image.image.image // .spec.image.image // empty' 2>/dev/null || true)
    else
        echo "bootc status failed: $(< "$bootc_stderr")" >&2
    fi
    rm -f "$bootc_stderr"
fi

if [[ -n "$booted_ref" ]]; then
    booted_image="${booted_ref%%@*}"
    booted_image="${booted_image##*/}"
    if [[ "$booted_image" == *:* ]]; then
        TAG="${booted_image##*:}"
    fi
fi

# Normalize tag to primary streams if matching standard aliases
case "$TAG" in
    stable*|gts*|lts) TAG="stable" ;;
    testing*|canary*|next*) TAG="testing" ;;
esac
if [[ "$TAG" != "stable" && "$TAG" != "testing" ]]; then
    echo "Booted stream unavailable; countme will retry" >&2
    exit 1
fi

# 8. Detect Game Mode status (1 if gamescope/steam session or gaming flavor is present)
GAMEMODE=0
WAYLAND_SESSIONS_DIR="${WAYLAND_SESSIONS_DIR:-/usr/share/wayland-sessions}"
if [[ "$FLAVOR" =~ gaming ]] || [[ "${raw_name:-}" =~ gaming ]]; then
    GAMEMODE=1
elif [[ -f "${WAYLAND_SESSIONS_DIR}/gamescope-session-steam.desktop" ]] || \
     [[ -f "${WAYLAND_SESSIONS_DIR}/gamescope-session.desktop" ]] || \
     command -v gamescope-session &>/dev/null; then
    GAMEMODE=1
fi

ARCH=$(uname -m)
OS_VERSION=$(grep '^VERSION_ID=' /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"' || echo "unknown")

# 9. Query countme endpoint using curl -G --data-urlencode
USER_AGENT="bluefin-countme (${REPO} ${OS_VERSION}; ${FLAVOR}; tag=${TAG}; gamemode=${GAMEMODE}; Linux.${ARCH})"
ENDPOINT="https://countme.projectbluefin.io/metalink"

QUERY_ARGS=(
    --data-urlencode "repo=${REPO}"
    --data-urlencode "tag=${TAG}"
    --data-urlencode "flavor=${FLAVOR}"
    --data-urlencode "gamemode=${GAMEMODE}"
    --data-urlencode "arch=${ARCH}"
    --data-urlencode "countme=${BUCKET}"
)

curl -sfG --retry 3 --max-time 15 -H "User-Agent: ${USER_AGENT}" \
    "${QUERY_ARGS[@]}" \
    "$ENDPOINT" -o /dev/null
echo "$NOW" > "$LASTRUN_FILE"

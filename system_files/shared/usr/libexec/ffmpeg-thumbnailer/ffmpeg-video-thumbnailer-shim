#!/usr/bin/env python3
"""
ffmpeg-video-thumbnailer-shim

Runs inside GNOME's thumbnailer bubblewrap sandbox, where no container runtime
can start (--unshare-all plus seccomp filter denying unshare/mount/CLONE_NEWUSER).
Hands the thumbnailing job to the ffmpeg-thumbnailer-daemon over a UNIX socket
located in ~/.cache/gnome-desktop-thumbnailer/gstreamer-1.0/, which is the one
writable host directory GNOME binds through at its real host path.

Usage: ffmpeg-video-thumbnailer-shim [-s SIZE] <INPUT> <OUTPUT>
"""

import argparse
import os
import shutil
import socket
import subprocess
import sys
import urllib.parse


def get_socket_path() -> str | None:
    cache_home = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    candidates = [
        os.environ.get("FFT_SOCKET"),
        os.path.join(
            cache_home,
            "gnome-desktop-thumbnailer",
            "gstreamer-1.0",
            "ffmpeg-thumbnailer.sock",
        ),
        os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), "ffmpeg-thumbnailer.sock"),
        f"/run/user/{os.getuid()}/ffmpeg-thumbnailer.sock",
    ]
    for c in candidates:
        if c and os.path.exists(c):
            return c
    return None


def fallback_local_ffmpeg(input_path: str, output_path: str, size: int) -> bool:
    ffmpeg_bin = shutil.which("ffmpeg")
    if not ffmpeg_bin:
        return False

    vf = (
        f"scale=min({size}\\,iw):min({size}\\,ih)"
        ":force_original_aspect_ratio=decrease"
    )
    for seek in ("00:00:03", "00:00:00"):
        cmd = [
            ffmpeg_bin, "-y", "-loglevel", "error",
            "-threads", "1",
            "-ss", seek,
            "-i", input_path,
            "-vf", vf,
            "-vframes", "1",
            "-update", "1",
            output_path,
        ]
        try:
            res = subprocess.run(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=15,
            )
            if res.returncode == 0 and os.path.exists(output_path) and os.path.getsize(output_path) > 0:
                return True
        except (subprocess.TimeoutExpired, OSError):
            continue
    return False


def main():
    parser = argparse.ArgumentParser(description="GNOME thumbnailer shim for ffmpeg-thumbnailer")
    parser.add_argument("-s", "--size", type=int, default=256, help="Thumbnail max dimension")
    parser.add_argument("input", help="Input video file or URI")
    parser.add_argument("output", help="Output thumbnail path")
    args = parser.parse_args()

    input_path = args.input
    if input_path.startswith("file://"):
        parsed = urllib.parse.urlparse(input_path)
        input_path = urllib.parse.unquote(parsed.path)

    output_path = args.output
    outdir = os.path.dirname(output_path)
    if outdir:
        os.makedirs(outdir, exist_ok=True)

    sock_path = get_socket_path()
    daemon_attempted = False

    if sock_path:
        in_fd = None
        out_fd = None
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(60.0)
        try:
            in_fd = os.open(input_path, os.O_RDONLY)
            out_fd = os.open(output_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
            sock.connect(sock_path)
            daemon_attempted = True
            socket.send_fds(sock, [f"THUMB\t{args.size}\n".encode("utf-8")], [in_fd, out_fd])
            resp = sock.recv(4096).decode("utf-8", errors="replace").strip()
            if resp == "OK" and os.path.exists(output_path) and os.path.getsize(output_path) > 0:
                sys.exit(0)
            sys.stderr.write(f"ffmpeg-thumbnailer: daemon returned '{resp}'\n")
            # If the daemon was reached and replied with an error, do not fall back
            # to an unthrottled local ffmpeg run. Let GNOME record the failure.
            sys.exit(1)
        except (ConnectionRefusedError, FileNotFoundError):
            # Daemon socket exists but daemon is not listening; fall through to local fallback
            daemon_attempted = False
        except Exception as exc:
            sys.stderr.write(f"ffmpeg-thumbnailer: daemon communication failed: {exc}\n")
            # If connect succeeded but communication timed out/failed, do not fan out
            if daemon_attempted:
                sys.exit(1)
        finally:
            for fd in (in_fd, out_fd):
                if fd is not None:
                    try:
                        os.close(fd)
                    except OSError:
                        pass
            sock.close()

    # Local fallback only runs if daemon was completely unreachable
    if not daemon_attempted and fallback_local_ffmpeg(input_path, output_path, args.size):
        sys.exit(0)

    sys.stderr.write(f"ffmpeg-thumbnailer: failed to thumbnail {input_path}\n")
    sys.exit(1)


if __name__ == "__main__":
    main()

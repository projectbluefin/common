#!/usr/bin/env bash

set -eou pipefail

BLING_CLI_DIRECTORY="${BLING_CLI_DIRECTORY:-/usr/share/ublue-os/bling}"

# bluefin-cli (https://github.com/tuna-os/bluefin-cli) replaces bling
# (projectbluefin/common#1719). Where it is installed, this command turns its
# shell experience on or off instead: bluefin-cli writes one line ending in
# this marker into the rc file in $HOME and removes bling's lines from it.
# bluefin-cli ignores ZDOTDIR and XDG_CONFIG_HOME, so when they move the rc
# file the shell reads, this command writes bling's block there instead;
# bling.sh and bling.fish hand over to `bluefin-cli init` themselves.
BLUEFIN_CLI_MARKER="# bluefin-cli shell-config"

BLING_SCRIPT_SOURCE=""
TARGET_CONFIG_FILE=""
BLUEFIN_CLI_RC=""
shell="$(basename "${SHELL}")"
case "${shell}" in
    "fish")
        BLING_SCRIPT_SOURCE="bling.fish"
        TARGET_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"
        BLUEFIN_CLI_RC="${HOME}/.config/fish/config.fish"
    ;;
    "zsh")
        BLING_SCRIPT_SOURCE="bling.sh"
        TARGET_CONFIG_FILE="${ZDOTDIR:-$HOME}/.zshrc"
        BLUEFIN_CLI_RC="${HOME}/.zshrc"
    ;;
    "bash")
        BLING_SCRIPT_SOURCE="bling.sh"
        TARGET_CONFIG_FILE="${HOME}/.bashrc"
        BLUEFIN_CLI_RC="${HOME}/.bashrc"
    ;;
    *)
        echo 'Unknown shell. You are on your own.'
        exit 1
    ;;
esac

function has-bluefin-cli() {
    command -v bluefin-cli >/dev/null 2>&1
}

# bluefin-cli's rc file is the one the shell actually reads.
function bluefin-cli-owns-rc() {
    has-bluefin-cli && [ "$(realpath -m "$BLUEFIN_CLI_RC")" = "$(realpath -m "$TARGET_CONFIG_FILE")" ]
}

function is-bling-installed() {
    if [ -f "$TARGET_CONFIG_FILE" ] && grep -q "source $BLING_CLI_DIRECTORY/$BLING_SCRIPT_SOURCE" "$TARGET_CONFIG_FILE"; then
        return 0
    fi
    bluefin-cli-owns-rc && [ -f "$TARGET_CONFIG_FILE" ] && grep -qF "$BLUEFIN_CLI_MARKER" "$TARGET_CONFIG_FILE"
}

function remove-bling-block() {
    [ -f "$TARGET_CONFIG_FILE" ] || return 0
    if ! sed -i "/### ${BLING_SCRIPT_SOURCE} source start/,/### ${BLING_SCRIPT_SOURCE} source end/d" "${TARGET_CONFIG_FILE}" ; then
        sed -i "$(grep -n "source ${BLING_SCRIPT_SOURCE}" "${TARGET_CONFIG_FILE}" | grep -Eo '^[^:]+')"d "${TARGET_CONFIG_FILE}"
    fi
}

# shellcheck source=/dev/null
[ -f "${BLING_ENV_SCRIPT:-/usr/share/ublue-os/bling/env.sh}" ] && . "${BLING_ENV_SCRIPT:-/usr/share/ublue-os/bling/env.sh}"

BLING_MESSAGE_ENABLE="${BLING_MESSAGE_ENABLE:-Enable bling for ${shell}?}"
BLING_MESSAGE_DISABLE="${BLING_MESSAGE_DISABLE:-Disable bling for ${shell}?}"

if is-bling-installed; then
    gum confirm "${BLING_MESSAGE_DISABLE}"
    remove-bling-block
    if bluefin-cli-owns-rc; then
        bluefin-cli shell "${shell}" off
    fi
    echo "Bling removed. Reopen your terminal so that the configurations may be removed"
else
    gum confirm "${BLING_MESSAGE_ENABLE}" --affirmative="Bling me up!" --negative "No, I'm boring"
    if bluefin-cli-owns-rc; then
        bluefin-cli shell "${shell}" on
    else
        echo "Adding bling to your $(basename "${TARGET_CONFIG_FILE}")"
        cat<<EOF >> "${TARGET_CONFIG_FILE}"
### ${BLING_SCRIPT_SOURCE} source start
test -f ${BLING_CLI_DIRECTORY}/${BLING_SCRIPT_SOURCE} && source ${BLING_CLI_DIRECTORY}/${BLING_SCRIPT_SOURCE}
### ${BLING_SCRIPT_SOURCE} source end
EOF
    fi
    echo "Installation complete. Reopen your terminal so that the configurations may be applied"
fi

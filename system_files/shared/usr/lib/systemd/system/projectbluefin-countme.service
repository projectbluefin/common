[Unit]
Description=Send daily active-system ping to Project Bluefin
Documentation=https://docs.projectbluefin.io/analytics
Wants=network-online.target
After=network-online.target
# Trigger conditions (|): run if /home is not empty OR the host is not
# ostree-booted. Bluefin Server is a DDI without /run/ostree-booted and is
# typically unattended (empty /home), so it is counted; bootc hosts (Dakota,
# Utah) with an empty /home (live ISO, unattended host) are still skipped.
ConditionDirectoryNotEmpty=|/home
ConditionPathExists=|!/run/ostree-booted
# Opt-out files honored by the previous bluefin-countme units.
ConditionPathExists=!/etc/projectbluefin/countme/disabled
ConditionPathExists=!/etc/bluefin-countme-opt-out
ConditionPathExists=!/etc/dakota-countme/disabled
# `systemctl mask` of the previous units, the opt-out documented for them.
ConditionPathExists=!/etc/systemd/system/bluefin-countme.timer
ConditionPathExists=!/etc/systemd/system/bluefin-countme.service

[Service]
Type=simple
ExecStart=/usr/libexec/projectbluefin-countme
StateDirectory=projectbluefin-countme

# Run as root (no DynamicUser) so bootc status can query status.
# Hardened sandbox:
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallFilter=@system-service @mount

[Unit]
Description=Refresh Flatpak remote metadata
Documentation=https://docs.projectbluefin.io
After=network-online.target flatpak-system-helper.service
Wants=network-online.target
ConditionPathExists=/usr/bin/flatpak
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
ExecCondition=bash -c 'v=$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager Metered 2>/dev/null | cut -d" " -f2); case "$v" in 1|3) exit 1;; esac'
ExecStart=/usr/bin/flatpak update --appstream --system --noninteractive
RemainAfterExit=yes
Restart=on-failure
RestartSec=60

# Started by flatpak-appstream-refresh.timer, never by a boot target: a target
# waits for the oneshot units it wants, so offline the retries held
# graphical.target for minutes. `systemctl enable` of this service enables
# the timer.
[Install]
Also=flatpak-appstream-refresh.timer

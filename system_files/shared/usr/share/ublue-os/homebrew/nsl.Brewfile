# NSL — WSL-style Linux development machines for atomic hosts
# Opt-in through ChairLift's Applications page or `ujust bbrew`.
# The cask installs the CLI only. Run `nsl doctor` to check host requirements:
# https://frostyard.github.io/nsl/getting-started/install/
tap "frostyard/tap", trusted: true
cask "frostyard/tap/nsl"

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>projectbluefin/renovate-config"
  ],
  "github-actions": {
    "managerFilePatterns": [
      "/^\\.github/copilot-setup-steps\\.yml$/"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^tests/requirements\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "COPY --from=(?<depName>ghcr\\.io/projectbluefin/bluefin-wallpapers-gnome):(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the ChairLift release whose helper, PolicyKit policy and GSettings schemas the Containerfile installs. CHAIRLIFT_RELEASE is the only pin: the build verifies the release's signed checksums.txt for that tag, so a bump is this one line.",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "ARG CHAIRLIFT_RELEASE=(?<currentValue>v[0-9][0-9A-Za-z.-]*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "projectbluefin/chairlift",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-(?<prerelease>.+))?$"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge digest/pin/patch/minor via GitHub native auto-merge (merge queue handles squash)",
      "matchUpdateTypes": [
        "digest",
        "pin",
        "patch",
        "minor"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Pin GitHub Actions digests to full SHAs",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action"
      ],
      "pinDigests": true
    },
    {
      "description": "Require human review for GitHub Actions minor/patch updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": false
    },
    {
      "description": "Automerge stable projectbluefin/chairlift release updates. Keep ignoreUnstable off so a prerelease is still surfaced if ChairLift ever publishes one, and automerge when checks pass.",
      "matchDepNames": [
        "projectbluefin/chairlift"
      ],
      "ignoreUnstable": false,
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Unit-test containers follow released Fedora only. Raise this when Fedora 46 is released (fedoraproject.org/releases.json lists it).",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.fedoraproject.org/fedora"
      ],
      "allowedVersions": "<=45"
    }
  ]
}

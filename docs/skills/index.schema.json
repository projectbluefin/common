{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/projectbluefin/common/docs/skills/index.schema.json",
  "title": "projectbluefin/common skill catalog",
  "description": "Machine-readable catalog of docs/skills/*.md front matter. Generated by scripts/generate_skill_index.py — do not edit index.json by hand.",
  "type": "object",
  "required": ["generated_at", "schema_version", "skills"],
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date",
      "description": "Date the catalog was last regenerated (UTC, YYYY-MM-DD)."
    },
    "schema_version": {
      "type": "string",
      "description": "Version of this schema the catalog was generated against."
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": [
        "id",
        "name",
        "one_line_purpose",
        "entry_point",
        "category",
        "status",
        "tags",
        "description",
        "version",
        "last_updated"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Kebab-case identifier. Matches the skill's front-matter `name` and file/directory stem."
        },
        "name": { "type": "string" },
        "one_line_purpose": {
          "type": "string",
          "maxLength": 120,
          "description": "Short imperative summary distinct from the longer `description`."
        },
        "entry_point": {
          "type": "string",
          "description": "Repo-relative path to the skill's canonical Markdown file.",
          "pattern": "^docs/skills/.+\\.md$"
        },
        "category": {
          "type": "string",
          "enum": ["ci-ops", "test-authoring", "meta", "platform", "product"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "deprecated", "reserved"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "maxLength": 256
        },
        "version": { "type": "string" },
        "last_updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "doc_type": {
          "type": "string",
          "description": "Value of front-matter metadata.type, if present (e.g. reference, procedure, runbook, policy)."
        }
      }
    }
  }
}
